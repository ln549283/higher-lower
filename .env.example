# Whichly - AdMob
# Pendant TOUS les tests, conserver true.
# Ne passer à false que pour le build de production destiné au Play Store.
VITE_ADMOB_TEST_MODE=true

# IDs d'unités interstitielles réelles créées dans AdMob.
# L'ID d'application AdMob se configure séparément dans AndroidManifest.xml / Info.plist.
VITE_ADMOB_INTERSTITIAL_ANDROID=
VITE_ADMOB_INTERSTITIAL_IOS=
